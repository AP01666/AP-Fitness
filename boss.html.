
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="theme-color" content="#070b16">
<title>AP SYSTEM | Boss Gate</title>
<style>
*{box-sizing:border-box}
body{margin:0;padding:20px;background:#070b16;color:#edf5ff;font-family:Arial,sans-serif}
main{max-width:560px;margin:auto}
.card{background:#101a30;border:1px solid #285080;border-radius:18px;padding:20px;margin:14px 0}
h1{color:#55b7ff;letter-spacing:3px}
h2{font-size:20px}
p{color:#b7c7e2;line-height:1.5}
button{width:100%;padding:14px;margin-top:12px;border:0;border-radius:10px;background:#42baff;color:#07101d;font-weight:bold;font-size:16px}
button:disabled{opacity:.4}
.quest{display:flex;gap:12px;padding:13px 0;border-bottom:1px solid #263652}
.quest input{width:22px;height:22px;accent-color:#55b7ff}
.tag{color:#75ddff;font-weight:bold;letter-spacing:2px}
.hidden{display:none}
small{color:#a8bad7}
</style>
</head>
<body>
<main>
<div class="tag">PLAYER SYSTEM // SPECIAL MISSION</div>
<h1>AP SYSTEM</h1>

<section class="card">
<h2 id="level">LEVEL 1</h2>
<p id="status">Complete three workout sessions to unlock your first boss.</p>
<p>Total XP: <strong id="xp">0</strong></p>
<p>Boss victories: <strong id="wins">0</strong></p>
</section>

<section class="card">
<div class="tag">⚔ BOSS GATE</div>
<h2 id="bossName">BOSS 01: THE GATEKEEPER</h2>
<p>Complete every objective safely to claim victory and unlock the next level.</p>
<div id="quests"></div>
<button id="victory" disabled>COMPLETE ALL OBJECTIVES FIRST</button>
<p><small>Warm up first and rest 60–120 seconds between sets. Stop if you experience pain, dizziness, chest pain or unusual shortness of breath.</small></p>
</section>

<section class="card">
<h2>System Log</h2>
<p id="log">Your boss journey starts here.</p>
<button id="reset" style="background:#273651;color:white">RESET BOSS DEMO</button>
</section>
</main>

<script>
const KEY="apBossGateDemo";
const bosses=[
 {name:"THE GATEKEEPER",tasks:[
 ["Push-ups","3 sets of 8 reps"],
 ["Dumbbell squats","3 sets of 12 reps"],
 ["Dumbbell rows","3 sets of 10 per side"],
 ["Plank","3 sets of 30 seconds"],
 ["Brisk walk or easy jog","5 minutes"]]},
 {name:"THE IRON WARDEN",tasks:[
 ["Push-ups","3 sets of 10 reps"],
 ["Dumbbell squats","3 sets of 14 reps"],
 ["Dumbbell rows","3 sets of 12 per side"],
 ["Plank","3 sets of 35 seconds"],
 ["Brisk walk or easy jog","7 minutes"]]},
 {name:"THE SHADOW BREAKER",tasks:[
 ["Push-ups","4 sets of 8 reps"],
 ["Dumbbell squats","4 sets of 12 reps"],
 ["Dumbbell rows","3 sets of 12 per side"],
 ["Plank","3 sets of 40 seconds"],
 ["Brisk walk or easy jog","8 minutes"]}
];
let data={level:1,xp:0,wins:[],ready:false,checks:[]};
try{data={...data,...JSON.parse(localStorage.getItem(KEY)||"{}")}}catch(e){}
const $=id=>document.getElementById(id);
function save(){localStorage.setItem(KEY,JSON.stringify(data));render()}
function render(){
 $("level").textContent="LEVEL "+data.level;
 $("xp").textContent=data.xp;
 $("wins").textContent=data.wins.length;
 $("status").textContent=data.ready?"BOSS GATE UNLOCKED. Enter the trial when ready.":"This is a separate demo. Your main app's workout progress is not connected to this page.";
 const boss=bosses[Math.min(data.level-1,bosses.length-1)];
 $("bossName").textContent="BOSS "+String(data.level).padStart(2,"0")+": "+boss.name;
 $("quests").innerHTML="";
 boss.tasks.forEach((task,i)=>{
  const row=document.createElement("label");
  row.className="quest";
  const box=document.createElement("input");
  box.type="checkbox";box.checked=!!data.checks[i];
  box.onchange=()=>{data.checks[i]=box.checked;save()};
  const text=document.createElement("span");
  text.innerHTML="<strong>"+task[0]+"</strong><br><small>"+task[1]+"</small>";
  row.append(box,text);$("quests").append(row);
 });
 $("victory").disabled=!data.ready||data.wins.includes(data.level)||!data.checks.slice(0,boss.tasks.length).every(Boolean);
 $("victory").textContent=data.wins.includes(data.level)?"BOSS DEFEATED":!data.ready?"UNLOCK THE GATE FIRST":"CLAIM BOSS VICTORY";
}
$("victory").onclick=()=>{
 if(!data.ready||data.wins.includes(data.level))return;
 const old=data.level;
 data.wins.push(old);data.xp+=300;data.level++;data.checks=[];data.ready=false;
 $("log").textContent="Boss defeated! Level "+data.level+" unlocked. This demo does not change your main app.";
 save();
};
$("reset").onclick=()=>{
 if(confirm("Reset this separate boss demo?")){
  data={level:1,xp:0,wins:[],ready:false,checks:[]};save();
 }
};
render();
</script>
</body>
</html>
